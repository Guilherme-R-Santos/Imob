<Window x:Name="window" x:Class="Imob.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Imob"
        mc:Ignorable="d"
        Title="Imob" UseLayoutRounding="True" Icon="/IcoImob.png"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Estilo para TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF77A10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para PasswordBox moderno -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão moderno -->
        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/LogoImob.png" Stretch="None"/>
        </Grid.Background>

        <!-- Painel de Login -->
        <Border x:Name="JanelaLogin" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="420" 
                Background="White"
                CornerRadius="12"
                Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="0" BlurRadius="30"/>
            </Border.Effect>

            <StackPanel>
                <!-- Título -->
                <TextBlock Text="Bem-vindo!" 
                          FontSize="32" 
                          FontWeight="Bold" 
                          Foreground="#FFF77A10"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Faça login para continuar" 
                          FontSize="14" 
                          Foreground="#999999"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,40"/>

                <!-- Campo de Login -->
                <TextBlock Text="USUÁRIO" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtUsuario" 
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,25"/>

                <!-- Campo de Senha -->
                <TextBlock Text="SENHA" Style="{StaticResource ModernLabel}"/>
                <PasswordBox x:Name="txtSenha" 
                            Style="{StaticResource ModernPasswordBox}"
                            Margin="0,0,0,15"/>

                <!-- Link Esqueci a Senha -->
                <TextBlock Text="Esqueci minha senha" 
                          FontSize="12" 
                          Foreground="#2196F3"
                          HorizontalAlignment="Right"
                          Margin="0,0,0,30"
                          Cursor="Hand"
                          MouseLeftButtonDown="EsqueciSenha_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Botão Entrar -->
                <Button x:Name="btnEntrar" 
                       Content="ENTRAR" 
                       Style="{StaticResource ModernButton}"
                       Background="Bisque"
                       Height="48"
                       Margin="0,0,0,0"
                       IsDefault="True"
                       Click="ButtonLogin_Click"/>
                <Button x:Name="btnCriar" 
                       Content="NOVO ACESSO" 
                       Style="{StaticResource ModernButton}"
                       Background="#FFF77A10"
                       Height="48"
                       Margin="0,10,0,0"
                       Click="btnCriar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
