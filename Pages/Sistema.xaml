<Window x:Class="Imob.Sistema"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Imob"
        mc:Ignorable="d"
        Title="Sistema" Height="1080" Width="1920" Icon="/IcoImob.png">
    <Window.Resources>
        <!-- Estilo para TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF77A10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para PasswordBox moderno -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão moderno -->
        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FFEA852F"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Estilo moderno para TreeViewItem: hover, clique transitório, sombra leve -->
        <Style TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#FFF27F1D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" CornerRadius="8" Padding="6" Background="{x:Null}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lateral expander mais simples (similar ao ícone padrão) -->
                                    <ToggleButton x:Name="Expander" Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path x:Name="ExpanderPath" Data="M 2 0 L 10 8 L 2 16 Z" Fill="#666" RenderTransformOrigin="0.5,0.5"/>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Margin="28,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ExpanderPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Esconder expander para itens folha -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <!-- Hover: efeito sutil com sombra e pequena escala (reverte no Exit) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFFDF6F0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#80000000" BlurRadius="12" ShadowDepth="4"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Clique transitório: pequena contração rápida e retorno (não persiste) -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.08" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.08" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Ensure the border has a ScaleTransform to animate -->
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid HorizontalAlignment="Center" Cursor="">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="191*"/>
            <ColumnDefinition Width="193*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/LogoImob.png" Stretch="None"/>
        </Grid.Background>
        <Grid x:Name="NavBar" HorizontalAlignment="Right" Height="66" VerticalAlignment="Top" Width="1920" Grid.ColumnSpan="2" Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-1.123"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.48"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7A486"/>
                    <GradientStop Color="#FFF77A10" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            </StackPanel>
            <Label x:Name="UsuarioAtivo" Content="UsuarioAtivo" HorizontalAlignment="Left" Height="58" Margin="1630,0,0,0" VerticalAlignment="Center" Width="211" Background="{x:Null}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="White" Foreground="White" FontSize="20"/>
            <Rectangle x:Name="RetangLogo" HorizontalAlignment="Left" Height="58" Margin="45,0,0,0" VerticalAlignment="Center" Width="228" Fill="White" RadiusY="10" RadiusX="10"/>
            <Image x:Name="LogoNav" Height="56" Width="118" Source="/LogoImob.png" OpacityMask="Black" HorizontalAlignment="Left" Margin="96,5,0,5"/>
            <Ellipse x:Name="CircPwrOff" HorizontalAlignment="Left" Height="49" Margin="1832,0,0,0" VerticalAlignment="Center" Width="49" Fill="#FFEFEFEF"/>
            <Image x:Name="ImgPwrOff" HorizontalAlignment="Left" Height="50" Margin="1857,0,0,0"Margin="1832,0,0,0" VerticalAlignment="Center" Width="52" Source="/Pages/icons8-power-off-64.png"/>
        </Grid>
        <TreeView x:Name="MenuNav" Margin="-1,66,635,532">
            <TreeView.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3"/>
            </TreeView.Effect>
            <TreeViewItem x:Name="ContratosTree" Header="Contratos" IsExpanded="False" FontSize="24" FontFamily="Segoe UI Variable Text Semibold" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand">
                <TreeViewItem x:Name="ContratosTreeListar" Header="Listar" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
                <TreeViewItem x:Name="ContratosCriar" Header="Novo" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
            </TreeViewItem>
            <TreeViewItem x:Name="ProprietariosTree" Header="Proprietários" IsExpanded="False" FontSize="24" FontFamily="Segoe UI Variable Text Semibold" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand">
                <TreeViewItem x:Name="ProprietariosTreeListar" Header="Listar" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
                <TreeViewItem x:Name="ProprietariosTreeCriar" Header="Novo" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
            </TreeViewItem>
            <TreeViewItem x:Name="LocatariosTree" Header="Locatários" IsExpanded="False" FontSize="24" FontFamily="Segoe UI Variable Text Semibold" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand">
                <TreeViewItem x:Name="LocatariosTreeListar" Header="Listar" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
                <TreeViewItem x:Name="LocatariosTreeCriar" Header="Novo" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
            </TreeViewItem>
            <TreeViewItem x:Name="ImoveisTree" Header="Imóveis" IsExpanded="False" FontSize="24" FontFamily="Segoe UI Variable Text Semibold" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand">
                <TreeViewItem x:Name="ImoveisTreeListar" Header="Listar" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
                <TreeViewItem x:Name="ImoveisTreeCriar" Header="Novo" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
            </TreeViewItem>
            <TreeViewItem x:Name="VistoriaTree" Header="Vistoria" IsExpanded="False" FontSize="24" FontFamily="Segoe UI Variable Text Semibold" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand">
                <TreeViewItem x:Name="VistoriaTreeListar" Header="Listar" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
                <TreeViewItem x:Name="VistoriaTreeCriar" Header="Novo" FontSize="22" BorderBrush="Black" Foreground="#FFF27F1D" Cursor="Hand"/>
            </TreeViewItem>
        </TreeView>
        <Image Height="100" Width="100"/>
    </Grid>
</Window>
