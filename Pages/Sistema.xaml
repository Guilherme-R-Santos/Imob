<Window x:Class="Imob.Sistema"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Imob"
        mc:Ignorable="d"
        Title="Sistema" Height="1080" Width="1920" Icon="/IcoImob.png">
    <Window.Resources>
        <!-- Estilo para TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFF77A10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para PasswordBox moderno -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão moderno -->
        <Style x:Key="ModernButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FFEA852F"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="191*"/>
            <ColumnDefinition Width="193*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/LogoImob.png" Stretch="None"/>
        </Grid.Background>
        <Grid x:Name="NavBar" HorizontalAlignment="Right" Height="66" VerticalAlignment="Top" Width="1920" Grid.ColumnSpan="2" Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-1.123"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.48"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7A486"/>
                    <GradientStop Color="#FFF77A10" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="LogoNav" Height="56" Width="176" Source="/LogoImob.png" OpacityMask="Black" HorizontalAlignment="Left" Margin="10,4,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            </StackPanel>
            <Label x:Name="UsuarioAtivo" Content="UsuarioAtivo" HorizontalAlignment="Left" Height="58" Margin="1705,0,0,0" VerticalAlignment="Center" Width="211" Background="{x:Null}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="White" Foreground="White" FontSize="20"/>
        </Grid>
        <!-- Removido CornerRadius do Menu, pois não é suportado -->
        <Menu x:Name="NavMenu" HorizontalAlignment="Left" Height="558" Margin="0,66,0,0" VerticalAlignment="Top" Width="320" Background="#FFF3F3F3" Foreground="#FFF47D18" BorderBrush="Coral" RenderTransformOrigin="1,1">
            <Menu.Effect>
                <DropShadowEffect Opacity="0.5" BlurRadius="20"/>
            </Menu.Effect>
            <MenuItem x:Name="Teste" Height="43" Width="320" Background="#FFD2643B" BorderBrush="#FFBB0303" Foreground="#FFF1862A" FontSize="36" Click="Teste_Click" Header="Teste" HorizontalAlignment="Center"></MenuItem>
        </Menu>
    </Grid>
</Window>
